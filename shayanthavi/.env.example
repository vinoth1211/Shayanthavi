# Neon PostgreSQL (pooled connection string recommended for serverless)
DATABASE_URL=

# NextAuth secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Admin credentials (used by seed script only)
ADMIN_EMAIL=admin@portfolio.local
ADMIN_PASSWORD=change-me-in-production

# Vercel Blob storage token (from Vercel dashboard > Storage > Blob)
BLOB_READ_WRITE_TOKEN=

# Match your Blob store access: "private" (default) or "public"
BLOB_ACCESS=private
